# TiUP topology (TiDB v8.5.7, cung nhanh voi docker/compose.tidb.yml). Render boi Terraform.
global:
  user: "tidb"
  ssh_port: 22
  deploy_dir: "/tidb-deploy"
  data_dir: "/tidb-data"

monitored:
  node_exporter_port: 9100

server_configs:
  pd:
    replication.max-replicas: 1 # luot chinh: 1 ban sao (nhom R moi dung 3)
  tikv:
    storage.block-cache.capacity: "1GiB" # cung gia tri o moi cum; ghi vao bao cao
    # Do ben Raft: giu mac dinh cua phien ban (khong tat dong bo log).

pd_servers:
  - host: ${pd}

tidb_servers:
  - host: ${tidb}

tikv_servers:
%{ for host in tikv ~}
  - host: ${host}
%{ endfor ~}

monitoring_servers:
  - host: ${monitor}

grafana_servers:
  - host: ${monitor}
